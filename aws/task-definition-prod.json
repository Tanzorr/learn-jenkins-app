{
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "family": "learn-jenkins-app-task-definition-prod",
  "containerDefinitions": [
    {
      "name": "learnjenkinsapp",
      "image": "781425929258.dkr.ecr.eu-north-1.amazonaws.com/my-jenkins-app:#APP VERSION#",
      "portMappings": [
        {
          "name": "nginx-80-tip",
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true
    }
  ],
  "volumes": [],
  "networkMode": "awsvpc",
  "memory": "512",
  "cpu": "256",
  "executionRoleArn": "arn:aws:iam::781425929258:role/ecsTaskExecutionRole"
}
